FROM node:22-slim AS deps
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/showcase/package.json ./apps/showcase/
COPY packages/contracts/package.json ./packages/contracts/

RUN npm install --no-audit --no-fund

FROM node:22-slim AS build
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/package.json /app/package-lock.json ./
COPY --from=deps /app/apps/showcase/package.json ./apps/showcase/
COPY --from=deps /app/packages/contracts/package.json ./packages/contracts/

COPY packages/contracts ./packages/contracts
COPY apps/showcase ./apps/showcase

RUN npm run build -w @onegoodarea/showcase

FROM node:22-slim AS runtime
WORKDIR /app

ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY --from=build /app/apps/showcase/.next/standalone ./
COPY --from=build /app/apps/showcase/.next/static ./apps/showcase/.next/static
COPY --from=build /app/apps/showcase/public ./apps/showcase/public

EXPOSE 3000
CMD ["node", "apps/showcase/server.js"]