# Local test runtime configuration
OGA_LOCAL_RUNTIME_ENABLED=true
OGA_SERVICE_MODE=local-test
OGA_LOG_LEVEL=debug
OGA_ENABLE_TESTING_AUTH_ROUTES=true
OGA_SEED_PROFILE=baseline
# OGA_SKIP_SEEDS=true
OGA_APP_PORT=3000
OGA_POSTGRES_PORT=55432
OGA_NEON_PROXY_PORT=55433
OGA_MAILHOG_UI_PORT=8025
POSTCODES_API_BASE_URL=https://api.postcodes.io
OGA_EMAIL_PROVIDER=mailhog

# Host-run scripts (bootstrap-test-key, promote-superuser, mint-session-token)
# connect to the local container stack via its published ports (compose/compose.override.yml).
DATABASE_URL=postgres://oga_user:oga_test_password_local@localhost:55432/oga_local
NEON_FETCH_ENDPOINT=http://localhost:55433/sql
# Must equal the running api's AUTH_SECRET (compose.yml) so minted bridge JWTs verify.
AUTH_SECRET=replace-me

# setup-test-tokens.sh overrides (optional; defaults apply when unset)
API_DOMAIN=http://localhost:8080
TEST_EMAIL=testuser@test.com
TEST_PASSWORD=TestPass1234
