COMPOSE_DIR ?= compose

COMPOSE_BASE ?= $(COMPOSE_DIR)/compose.yml
COMPOSE_OVERRIDE ?= $(COMPOSE_DIR)/compose.override.yml
COMPOSE_TEST ?= $(COMPOSE_DIR)/compose.test.yml

COMPOSE_DEV_MOCKED ?= $(COMPOSE_DIR)/compose.dev-mocked.yml
COMPOSE_DEV_REAL ?= $(COMPOSE_DIR)/compose.dev-real.yml

COMPOSE_FILES = -f $(COMPOSE_BASE) -f $(COMPOSE_OVERRIDE)

CTR_COMPOSE_CMD = $(CTR_COMPOSE) $(COMPOSE_FILES)

CTR_COMPOSE_TEST_BASE = $(CTR_COMPOSE) -f $(COMPOSE_TEST)

CTR_COMPOSE_MOCKED = $(CTR_COMPOSE) -f $(COMPOSE_BASE) -f $(COMPOSE_DEV_MOCKED)
CTR_COMPOSE_REAL = $(CTR_COMPOSE) -f $(COMPOSE_BASE) -f $(COMPOSE_DEV_REAL)

BUILD_FLAG ?=
BUILD_FLAG_TEST ?=
